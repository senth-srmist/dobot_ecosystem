# MAGIC BOX RELATED

Add the following function in the file MagicBox.py in the DobotEDU instalaltion folder to have the stepper motor connected to STP1 port with distance set points:

@get_portname
    @pause
    def set_stp1_distance(
            self,
            port_name,
            distance,
            speed=100,
            is_queued=False):
    
        STEP_PER_CIRCLE = 360.0 / 1.8 * 5.0 * 16.0
        MM_PER_CIRCLE = math.pi * 32.0
    
        # Pulses per mm
        pulses_per_mm = STEP_PER_CIRCLE / MM_PER_CIRCLE
    
        # Convert distance to pulses
        distance_pulses = abs(distance) * pulses_per_mm
    
        # Convert speed from mm/s to pulses/s
        speed_pulses = abs(speed) * pulses_per_mm
    
        # Direction
        if distance < 0:
            speed_pulses = -speed_pulses
    
        # Time required
        move_time = distance_pulses / abs(speed_pulses)
    
        # Start STP1
        self.__dobotlink.MagicBox.SetEMotor(
            portName=port_name,
            index=self.STP1,
            enable=True,
            speed=int(speed_pulses),
            isQueued=is_queued
        )
    
        # Let it run
        time.sleep(move_time)
    
        # Stop STP1
        return self.__dobotlink.MagicBox.SetEMotor(
            portName=port_name,
            index=self.STP1,
            enable=False,
            speed=0,
            isQueued=is_queued
        )
